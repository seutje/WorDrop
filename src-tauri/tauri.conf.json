{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorDrop",
  "version": "0.8.0",
  "identifier": "com.wordrop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WorDrop",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/image-classification/*": "image-classification/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "resources/windows-runtime/msvcp140.dll": "msvcp140.dll",
      "resources/windows-runtime/msvcp140_1.dll": "msvcp140_1.dll",
      "resources/windows-runtime/vcruntime140.dll": "vcruntime140.dll",
      "resources/windows-runtime/vcruntime140_1.dll": "vcruntime140_1.dll",
      "resources/windows-runtime/REDIST.txt": "windows-runtime/REDIST.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/seutje/WorDrop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMEZFRUQyQ0M1RDZBMjgKUldRb2FsM00wdTRQWHRTaUN5WXFlK0xtR0lpMkxOR3oxK2ZTUW5HNTFvekpkNmhtVEhTa1VGNWcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
